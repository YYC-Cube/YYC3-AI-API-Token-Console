{
  "name": "yyc3-ai-api-token-console",
  "private": true,
  "version": "0.2.0",
  "description": "YYC³ AI Family Token Console — 本地闭环多端推理矩阵数据看盘系统",
  "keywords": [
    "api-token-console",
    "token-usage-dashboard",
    "llm-gateway-monitoring",
    "inference-matrix",
    "multi-provider",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "shadcn-ui",
    "radix-ui",
    "recharts",
    "codemirror",
    "react-router",
    "vitest",
    "pnpm",
    "github-pages",
    "spa",
    "yyc3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port 3030",
    "dev:host": "vite --port 3030 --host",
    "build": "vite build && node scripts/inject-precache.mjs",
    "preview": "vite preview --port 3030",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 500",
    "lint:fix": "eslint . --fix",
    "deploy": "pnpm build && node deploy/server.mjs",
    "serve:local": "node deploy/server.mjs",
    "serve:console": "node deploy/console-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit-dom --project unit-node",
    "test:integration": "YYC3_TEST_INTEGRATION=1 vitest run --project integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "pnpm test:unit --reporter=junit --outputFile=test-results/junit.xml",
    "knip": "knip",
    "doctor": "node scripts/doctor.mjs",
    "astgrep": "node_modules/@ast-grep/cli/ast-grep scan -c scripts/ast-grep/sgconfig.yml src/",
    "guardrail-probe": "node scripts/guardrail-probe.mjs",
    "size:check": "node scripts/check-size.mjs",
    "nav:bench": "node scripts/nav-token-bench.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@uiw/react-codemirror": "4.25.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "2.1.7",
    "react-router": "7.18.4",
    "react-swipeable": "7.0.2",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@eslint/js": "catalog:",
    "@playwright/test": "1.63.0",
    "@tailwindcss/oxide": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "4.13.0",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "28.1.0",
    "knip": "6.37.0",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "0.1.0"
  }
}
